# ==========================================================
# NexusCRM - Environment Variables
# Copy this file to `.env` and fill in real values.
# ==========================================================

# ----- Django core -----
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-50-character-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# ----- Database (PostgreSQL) -----
POSTGRES_DB=nexuscrm
POSTGRES_USER=nexuscrm
POSTGRES_PASSWORD=nexuscrm
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://nexuscrm:nexuscrm@db:5432/nexuscrm

# ----- Redis / Celery / Channels -----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNEL_LAYERS_URL=redis://redis:6379/3

# ----- JWT -----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# ----- Email -----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NexusCRM <no-reply@nexuscrm.io>

# ----- Frontend URL (used in emails / verification links) -----
FRONTEND_URL=http://localhost:5173

# ----- Google OAuth -----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ----- OpenAI / LangChain -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=1200
OPENAI_TEMPERATURE=0.3
AI_ENABLED=True

# ----- File storage -----
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
MAX_UPLOAD_SIZE_MB=25

# ----- Backups -----
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14

# ----- Sentry (optional) -----
SENTRY_DSN=

# ----- Frontend build-time -----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_GOOGLE_CLIENT_ID=
